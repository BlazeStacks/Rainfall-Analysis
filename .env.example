# Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# NEVER commit .env to version control.

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Create a .env file inside the frontend/ directory and set this variable
# to point to your backend API. The default (localhost:8080) works for local dev.

# frontend/.env
VITE_API_URL=http://localhost:8080/api/rainfall

# ── Backend (Spring Boot) ────────────────────────────────────────────────────
# If you add PostgreSQL in the future, configure these in
# backend/rainfall-api/src/main/resources/application.properties
# or pass them as environment variables when running the JAR.

# Database (optional – not required for CSV-mode)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rainfall_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password_here

# Server port (default: 8080)
# SERVER_PORT=8080
